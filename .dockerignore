# Prevent local developer credentials and environment files from entering Docker build contexts
.env
*.env
.env.*
**/.env
**/.env.*
!**/.env.example
.envrc
**/.envrc
.gcloud/
**/.gcloud/
*.key
**/*.key
*.pem
**/*.pem
object-viewer-sa.json
credentials/
secrets/

# VCS, virtualenvs, and caches
.git
.gitignore
.venv/
**/.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
