# Zero-secret AX Task container image for mcp-security-agent.
# Implements the AX custom task image contract (BuildActorTemplate):
#   - /usr/local/bin/ax-task-runner entrypoint
#   - Port 80 /healthz and /readyz wakeup probe server
#   - Loopback AX_METADATA_URL server (/metadata/v1alpha1/ax/{task,workspace})
#   - Idempotent /workspace materialization before spawning Task.spec.command
#
# Build from the repository root:
#   PROJECT_ID="my-secops-project"
#   docker build -f deployments/ax-mcp-gateway/Dockerfile.ax-agent \
#     -t "us-docker.pkg.dev/$PROJECT_ID/secops-mcp/mcp-security-agent:v0.1.0" .
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AX_ZERO_SECRET_SANDBOX=true \
    MCP_GATEWAY_AUTH_HEADER="Bearer ate-egress-injected" \
    AX_RUNNER_PORT=80 \
    AX_METADATA_PORT=8099 \
    PORT=8080

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.6.10 /uv /usr/local/bin/uv

COPY deployments/ax-mcp-gateway /app/deployments/ax-mcp-gateway
COPY run-with-google-adk /app/run-with-google-adk

RUN uv pip install --system \
      "/app/deployments/ax-mcp-gateway" \
      "/app/run-with-google-adk" && \
    test -x /usr/local/bin/ax-task-runner && \
    test -x /usr/local/bin/mcp-security-agent && \
    mkdir -p /workspace

WORKDIR /workspace

EXPOSE 80 8080

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
