# Google Cloud & LLM Settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=
# Default Gemini 3+ model (use gemini-3-flash-preview for lower-latency triage)
GOOGLE_MODEL=gemini-3.1-pro-preview

# MCP Server Enablement Flags
# (SecOps, GTI, SOAR, and SCC auto-enable when credentials or remote URLs below are populated.
# Explicitly set LOAD_*_MCP to Y or N to override auto-detection.)
LOAD_SCC_MCP=Y
# LOAD_SECOPS_MCP=
# LOAD_GTI_MCP=
# LOAD_SECOPS_SOAR_MCP=

# Remote Streamable HTTP MCP Endpoints (Optional; leave blank to run local stdio servers)
# SECOPS_MCP_URL=http://127.0.0.1:8080/mcp
# CHRONICLE_REMOTE_MCP_URL=https://us-chronicle.googleapis.com/mcp
# GTI_MCP_URL=http://127.0.0.1:8081/mcp
# SOAR_MCP_URL=http://127.0.0.1:8082/mcp
# SCC_MCP_URL=http://127.0.0.1:8083/mcp
# MCP_REMOTE_AUTH_MODE=oauth
# MCP_BEARER_TOKEN=

# Credentials & Service Account Impersonation
SECOPS_SA_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
SECOPS_IMPERSONATE_SERVICE_ACCOUNT=

# Google Security Operations (SIEM) Settings - Populating enables SecOps MCP
CHRONICLE_PROJECT_ID=
CHRONICLE_CUSTOMER_ID=
CHRONICLE_REGION=us

# Google Threat Intelligence (GTI / VirusTotal) - Populating enables GTI MCP
VT_APIKEY=

# Google Security Operations SOAR Settings - Populating enables SOAR MCP
SOAR_URL=
SOAR_APP_KEY=

# ADK v2.13 & MCP v2.3 Runtime Settings
MCP_TOOL_NAME_PREFIX_ENABLED=N
MCP_USE_RESOURCES=Y
MCP_TOOL_LIST_CACHE_TTL_SECONDS=300.0
MCP_FILTER_BLOAT_FEED_TOOLS=Y
ADK_CONFIRM_DESTRUCTIVE_TOOLS=N
ADK_ELICITATION_POLICY=prompt
ADK_MAX_TOOL_OUTPUT_SCHEMA_BYTES=4096
STDIO_PARAM_TIMEOUT=60.0
MCP_HTTP_TIMEOUT=60.0
MCP_SSE_READ_TIMEOUT=300.0
MINIMAL_LOGGING=N
